Tool Change
Moves to the fixed sensor, lets you swap the tool, then re-applies the stored reference height.


; Keep these values aligned with Macro 1/2 so the tool sensor remains consistent; adjust SAFE_HEIGHT if clamps differ.
%macro.state.SAFE_HEIGHT = -5
%macro.state.PROBE_X_LOCATION = -1.5
%macro.state.PROBE_Y_LOCATION = -1224
%macro.state.PROBE_Z_LOCATION = float(app.settings.get("macro_probe_z_location", -5.0))
%macro.state.PROBE_SAFETY_MARGIN = max(0.0, float(app.settings.get("macro_probe_safety_margin", 3.0)))
%macro.state.grbl_settings = getattr(getattr(app, "settings_controller", None), "_settings_data", {}) or {}
%macro.state.z_max_travel_entry = macro.state.grbl_settings.get("$132")
%macro.state.z_max_travel_raw = macro.state.z_max_travel_entry[0] if isinstance(macro.state.z_max_travel_entry, (list, tuple)) and len(macro.state.z_max_travel_entry) > 0 else macro.state.z_max_travel_entry
%macro.state.z_max_travel_text = str(macro.state.z_max_travel_raw or "").strip()
%if (not macro.state.z_max_travel_text) or (not macro.state.z_max_travel_text.replace(".", "", 1).replace("-", "", 1).isdigit()): raise RuntimeError("GRBL $132 (max Z travel) is required before running Tool Change; refresh settings first.")
%macro.state.Z_MAX_TRAVEL = float(macro.state.z_max_travel_text)
%if macro.state.Z_MAX_TRAVEL <= 0: raise RuntimeError("GRBL $132 (max Z travel) must be greater than zero before running Tool Change.")
%macro.state.PROBE_DISTANCE = max(1.0, round(macro.state.Z_MAX_TRAVEL + macro.state.PROBE_Z_LOCATION - macro.state.PROBE_SAFETY_MARGIN, 3))
%macro.state.PROBE_RAPID_FEEDRATE = 200

%if getattr(macro.state, "TOOL_REFERENCE", None) is None: raise RuntimeError("TOOL_REFERENCE not set; run Macro 3 (Job Setup) first.")

%wait
%WCS = WCS
%PLANE = plane
%UNITS = units
%DISTANCE = distance
%FEEDMODE = feedmode
%SPINDLE = spindle
%COOLANT = coolant
%msg (Tool change start: units=[units] WCS=[WCS] wx=[wx] wy=[wy] wz=[wz] mx=[mx] my=[my] mz=[mz] TOOL_REFERENCE=[macro.state.TOOL_REFERENCE])
G21
M5
G90
G53 G0 Z[macro.state.SAFE_HEIGHT]
G53 G0 X[macro.state.PROBE_X_LOCATION] Y[macro.state.PROBE_Y_LOCATION]
%wait
%macro.tool_change_context = str(getattr(macro.state, "TOOL_CHANGE_CONTEXT", "") or "").strip().lower()
%macro.required_tool_name = str(getattr(macro.state, "REQUIRED_TOOL_NAME", "") or "").strip()
%macro.tool_change_prompt = ""
%if macro.tool_change_context == "stream" and macro.required_tool_name: macro.tool_change_prompt = f"Please remove current tool and replace with {macro.required_tool_name}. Press Resume once tool is swapped or Cancel to end job."
%if not macro.tool_change_prompt: macro.tool_change_prompt = "Please swap tool. Press Resume once tool is swapped or Cancel to abort."
M0 ([macro.tool_change_prompt])
G53 Z[macro.state.PROBE_Z_LOCATION]
G91
G38.2 Z-[macro.state.PROBE_DISTANCE] F[macro.state.PROBE_RAPID_FEEDRATE]
G0 Z2
G4 P0.25
G38.2 Z-5 F40
G4 P0.25
G38.4 Z10 F20
G4 P0.25
G38.2 Z-2 F5
G4 P0.25
G38.4 Z10 F5
G90
%wait
%update
%msg (New tool probe mz=[mz])
G10 L20 Z[macro.state.TOOL_REFERENCE]
%wait
%update
%msg (After G10: wz=[wz] mz=[mz])
G91
G0 Z5
G90
G53 Z[macro.state.SAFE_HEIGHT]
%wait
G0 X0 Y0
STATE_RETURN
