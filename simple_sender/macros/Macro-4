Tool Change
Moves to the fixed sensor, lets you swap the tool, then re-applies the stored reference height.


; Keep these values aligned with Macro 1/2 so the tool sensor remains consistent; adjust SAFE_HEIGHT if clamps differ.
%macro.state.SAFE_HEIGHT = -5
%macro.state.PROBE_X_LOCATION = -1.5
%macro.state.PROBE_Y_LOCATION = -1224
%macro.state.PROBE_Z_LOCATION = float(app.settings.get("macro_probe_z_location", -5.0))
%macro.state.PROBE_SAFETY_MARGIN = max(0.0, float(app.settings.get("macro_probe_safety_margin", 3.0)))
%macro.state.PROBE_SPREAD_TOLERANCE_MM = max(0.001, float(app.settings.get("macro_tool_probe_spread_tolerance_mm", tool_measurement.DEFAULT_TOOL_PROBE_SPREAD_TOLERANCE_MM)))
%macro.state.MAX_TOOL_LENGTH_DELTA_MM = max(1.0, float(app.settings.get("macro_tool_change_review_threshold_mm", tool_measurement.DEFAULT_TOOL_CHANGE_REVIEW_THRESHOLD_MM)))
%macro.state.JOG_FEED_Z_RAW = getattr(getattr(app, "jog_feed_z", None), "get", lambda: app.settings.get("jog_feed_z", 500.0))()
%macro.state.grbl_settings = getattr(getattr(app, "settings_controller", None), "_settings_data", {}) or {}
%macro.state.z_max_travel_entry = macro.state.grbl_settings.get("$132")
%macro.state.z_max_travel_raw = macro.state.z_max_travel_entry[0] if isinstance(macro.state.z_max_travel_entry, (list, tuple)) and len(macro.state.z_max_travel_entry) > 0 else macro.state.z_max_travel_entry
%macro.state.z_max_travel_text = str(macro.state.z_max_travel_raw or "").strip()
%if (not macro.state.z_max_travel_text) or (not macro.state.z_max_travel_text.replace(".", "", 1).replace("-", "", 1).isdigit()): raise RuntimeError("GRBL $132 (max Z travel) is required before running Tool Change; refresh settings first.")
%macro.state.Z_MAX_TRAVEL = float(macro.state.z_max_travel_text)
%if macro.state.Z_MAX_TRAVEL <= 0: raise RuntimeError("GRBL $132 (max Z travel) must be greater than zero before running Tool Change.")
%macro.state.PROBE_DISTANCE = max(1.0, round(macro.state.Z_MAX_TRAVEL + macro.state.PROBE_Z_LOCATION - macro.state.PROBE_SAFETY_MARGIN, 3))
%macro.state.PROBE_RAPID_FEEDRATE = max(1.0, float(macro.state.JOG_FEED_Z_RAW))

%if getattr(macro.state, "TOOL_REFERENCE", None) is None: raise RuntimeError("TOOL_REFERENCE not set; run Macro 3 (Job Setup) first.")
%macro.state.TOOL_REFERENCE_FORMAT_TEXT = str(getattr(macro.state, "TOOL_REFERENCE_FORMAT", "") or "").strip()
%if macro.state.TOOL_REFERENCE_FORMAT_TEXT != tool_measurement.CURRENT_TOOL_REFERENCE_FORMAT: raise RuntimeError("Tool reference is missing the current sensor-reference format; rerun Macro 3 (Job Setup) before changing tools.")
%macro.state.TOOL_REFERENCE_WZ = round(float(getattr(macro.state, "TOOL_REFERENCE_WZ", macro.state.TOOL_REFERENCE)), 4)
%macro.state.TOOL_REFERENCE_MZ = round(float(getattr(macro.state, "TOOL_REFERENCE_MZ", macro.state.TOOL_REFERENCE)), 4)

%wait
%WCS = WCS
%PLANE = plane
%UNITS = units
%DISTANCE = distance
%FEEDMODE = feedmode
%SPINDLE = spindle
%COOLANT = coolant
%msg (Tool change start: units=[units] WCS=[WCS] wx=[wx] wy=[wy] wz=[wz] mx=[mx] my=[my] mz=[mz] TOOL_REFERENCE=[macro.state.TOOL_REFERENCE])
G21
M5
G90
G53 G0 Z[macro.state.SAFE_HEIGHT]
G53 G0 X[macro.state.PROBE_X_LOCATION] Y[macro.state.PROBE_Y_LOCATION]
%wait
%macro.tool_change_context = str(getattr(macro.state, "TOOL_CHANGE_CONTEXT", "") or "").strip().lower()
%macro.required_tool_name = str(getattr(macro.state, "REQUIRED_TOOL_NAME", "") or "").strip()
%macro.tool_change_prompt = ""
%if macro.tool_change_context == "stream" and macro.required_tool_name: macro.tool_change_prompt = f"Please remove current tool and replace with {macro.required_tool_name}. Press Resume once tool is swapped or Cancel to end job."
%if not macro.tool_change_prompt: macro.tool_change_prompt = "Please swap tool. Press Resume once tool is swapped or Cancel to abort."
M0 ([macro.tool_change_prompt])
G53 Z[macro.state.PROBE_Z_LOCATION]
%msg (Tool change measurement: fixed sensor ready; reference_mz=[macro.state.TOOL_REFERENCE_MZ] tolerance_mm=[macro.state.PROBE_SPREAD_TOLERANCE_MM].)
%macro.state.CURRENT_TOOL_MEASUREMENT = app.macro_executor.measure_tool_probe_machine_z(probe_distance_mm=macro.state.PROBE_DISTANCE, rapid_feed_mm_min=macro.state.PROBE_RAPID_FEEDRATE, spread_tolerance_mm=macro.state.PROBE_SPREAD_TOLERANCE_MM, measurement_label="Tool change measurement", allow_tool_change_retry=True)
%macro.state.CURRENT_TOOL_PROBE_MZ = round(float(macro.state.CURRENT_TOOL_MEASUREMENT.machine_z), 4)
%macro.state.CURRENT_TOOL_PROBE_SPREAD_MM = round(float(macro.state.CURRENT_TOOL_MEASUREMENT.spread_mm), 4)
%wait
%update
%macro.state.TOOL_CHANGE_COMPENSATION = tool_measurement.build_tool_change_compensation(reference_work_z=macro.state.TOOL_REFERENCE_WZ, reference_machine_z=macro.state.TOOL_REFERENCE_MZ, current_machine_z=macro.state.CURRENT_TOOL_PROBE_MZ)
%macro.state.TOOL_LENGTH_DELTA_MM = round(float(macro.state.TOOL_CHANGE_COMPENSATION.delta_mm), 4)
%macro.state.TOOL_TARGET_WZ = round(float(macro.state.TOOL_CHANGE_COMPENSATION.target_work_z), 4)
%macro.state.REVIEW_REQUIRED = bool(tool_measurement.delta_exceeds_review_limit(macro.state.TOOL_LENGTH_DELTA_MM, macro.state.MAX_TOOL_LENGTH_DELTA_MM))
%msg (Tool change calculation: reference_wz=[macro.state.TOOL_REFERENCE_WZ] reference_mz=[macro.state.TOOL_REFERENCE_MZ] current_mz=[macro.state.CURRENT_TOOL_PROBE_MZ] current_wz_observed=[wz] delta_mm=[macro.state.TOOL_LENGTH_DELTA_MM] target_wz=[macro.state.TOOL_TARGET_WZ] review_threshold_mm=[macro.state.MAX_TOOL_LENGTH_DELTA_MM] review_required=[macro.state.REVIEW_REQUIRED])
%if macro.state.REVIEW_REQUIRED: app.macro_executor._macro_log(f"Tool change review required: delta_mm={macro.state.TOOL_LENGTH_DELTA_MM} exceeds threshold_mm={macro.state.MAX_TOOL_LENGTH_DELTA_MM}; waiting for operator Apply/Cancel before offset write.")
["PROMPT resumelabel=Apply [title(Tool Change Review)] The measured tool-length change is [macro.state.TOOL_LENGTH_DELTA_MM] mm, which exceeds the automatic review threshold of [macro.state.MAX_TOOL_LENGTH_DELTA_MM] mm. Press Apply to commit this offset or Cancel to abort before the offset write." if macro.state.REVIEW_REQUIRED else ""]
%if macro.state.REVIEW_REQUIRED: app.macro_executor._macro_log("Tool change review accepted by operator; continuing with offset write.")
%msg (Applying tool-change offset write: G10 L20 Z[macro.state.TOOL_TARGET_WZ])
G10 L20 Z[macro.state.TOOL_TARGET_WZ]
%wait
%update
%msg (Tool change offset committed: G10 L20 applied; target_wz=[macro.state.TOOL_TARGET_WZ] resulting_wz=[wz] mz=[mz])
G91
G0 Z5
G90
G53 Z[macro.state.SAFE_HEIGHT]
%wait
G0 X0 Y0
STATE_RETURN
